##############################################
# Client-side OpenVPN 2.6 config file        #
# Adapted for tls-crypt + modern ciphers   #
##############################################

client
dev tun
proto udp
remote <VPN_SERVER_IP> 1194
resolv-retry infinite
nobind
persist-tun

# Drop persist-key: it’s deprecated in OpenVPN 2.5+ (keys are always persisted)
# persist-key  <-- удалено

# Credentials
ca ca.crt
cert client.crt
key client.key

# TLS crypt (direction 0 for client)
tls-crypt ta.key 0

# Verify server certificate
remote-cert-tls server

# Modern ciphers only (no legacy fallback needed if server supports AEAD)
data-ciphers AES-256-GCM:AES-128-GCM:?CHACHA20-POLY1305

# Key direction for tls-crypt (1 for client)
key-direction 1

# Notify server on clean exit (helps with session cleanup)
explicit-exit-notify 1

verb 3

