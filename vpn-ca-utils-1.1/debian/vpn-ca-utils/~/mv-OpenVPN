#!/usr/bin/env bash
set -euo pipefail

mv /tmp/ca.crt /etc/openvpn/server/
echo '/etc/openvpn/server/ca.crt'
mv /tmp/server.crt /etc/openvpn/server/
echo '/etc/openvpn/server/server.crt'
mv /etc/openvpn/easy-rsa/ta.key /etc/openvpn/server/
echo '/etc/openvpn/server/ta.key'
chown root:root /etc/openvpn/server/*
chmod 644 /etc/openvpn/server/ca.crt
chmod 644 /etc/openvpn/server/server.crt
chmod 600 /etc/openvpn/server/server.key
