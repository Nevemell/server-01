#!/usr/bin/env bash
set -euo pipefail

CLIENT_NAME="$1"
SERVER_IP="$2"
PKI_DIR="${PKI_DIR:-/etc/openvpn/easy-rsa}"
OUTPUT_DIR="${OUTPUT_DIR:-/etc/openvpn/client/clients}"

if [[ -z "${CLIENT_NAME:-}" || -z "${SERVER_IP:-}" ]]; then
  echo "Usage: $0 <client-name> <server-ip>" >&2
  exit 1
fi

mkdir -p "$OUTPUT_DIR/$CLIENT_NAME"
cd "$PKI_DIR"

# Пути внутри PKI (стандарт EasyRSA 3.x)
CA_CRT="/etc/openvpn/server/ca.crt"
CLIENT_CRT="/etc/openvpn/client/${CLIENT_NAME}.crt"
CLIENT_KEY="/etc/openvpn/easy-rsa/pki/private/${CLIENT_NAME}.key"
TA_KEY="/etc/openvpn/server/ta.key"

# --- ЭТАП 1: генерация запроса и подпись (выполняется только если нет сертификата и ключа) ---
if [[ ! -f "$CLIENT_CRT" || ! -f "$CLIENT_KEY" ]]; then
  echo "Generating and signing client '$CLIENT_NAME'..."

  # 1. Генерируем запрос (без пароля)
  ./easyrsa gen-req "$CLIENT_NAME" nopass
  exit 1
else
  echo "Client '$CLIENT_NAME' already signed (cert/key exist), skipping generation."
fi

# Проверка, что все файлы существуют
for f in "$CA_CRT" "$CLIENT_CRT" "$CLIENT_KEY" "$TA_KEY"; do
  if [[ ! -f "$f" ]]; then
    echo "Error: required file not found: $f" >&2
    exit 1
  fi
done

# Копирование файлов в выходной каталог
cp "$CA_CRT" "$CLIENT_CRT" "$CLIENT_KEY" "$TA_KEY" "$OUTPUT_DIR/$CLIENT_NAME/"

# Генерация client.ovpn на основе шаблона
sed "s/<VPN_SERVER_IP>/${SERVER_IP}/g" /etc/openvpn/client/client.conf.template > \
  "$OUTPUT_DIR/$CLIENT_NAME/client.ovpn"

echo "Client '$CLIENT_NAME' generated successfully in: $OUTPUT_DIR/$CLIENT_NAME"

