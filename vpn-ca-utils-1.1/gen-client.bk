#!/usr/bin/env bash
set -euo pipefail

PKI_DIR="${PKI_DIR:-/etc/openvpn/easy-rsa}"
CLIENT_NAME="$1"
SERVER_IP="$2"

if [[ -z "$CLIENT_NAME" || -z "$SERVER_IP" ]]; then
  echo "Usage: $0 <client-name> <server-ip>" >&2
  exit 1
fi

cd "$PKI_DIR"

# Генерируем ключи (можно без nopass, если нужен пароль)
./easyrsa build-client-full "$CLIENT_NAME" nopass

# Создаём конфиг
cat /usr/share/openvpn-ca/templates/client.conf.template \
  | sed "s/<VPN_SERVER_IP>/$SERVER_IP/" > "../client/${CLIENT_NAME}.ovpn"
