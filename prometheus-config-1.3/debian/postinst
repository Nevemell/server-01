#!/bin/sh
set -e

#DEBHELPER#

case "$1" in
    configure)
        if command -v promtool >/dev/null 2>&1 \
           && promtool check config /etc/prometheus/prometheus.yml >/dev/null 2>&1; then
            systemctl reload prometheus >/dev/null 2>&1 || true
        else
            echo "prometheus-config: конфигурация Prometheus невалидна или promtool не найден, reload пропущен" >&2
            echo "prometheus-config: проверьте rule_files в /etc/prometheus/prometheus.yml" >&2
        fi
        ;;
esac

exit 0
